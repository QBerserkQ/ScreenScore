<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox styleClass="detail-panel" maxHeight="-Infinity" alignment="CENTER"
      maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="400.0" prefWidth="250.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.screenscore.controllers.DetailController">
   <children>
      <Label alignment="CENTER" prefHeight="40.0" prefWidth="250.0" text="Statistics" textAlignment="CENTER">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Line endX="250.0" />
      <Label alignment="CENTER" prefHeight="40.0" prefWidth="250.0" text="Reviews by Type" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <PieChart fx:id="pieChart" prefHeight="150.0" />
      <Line endX="250.0" />
      <Label alignment="CENTER" prefHeight="40.0" prefWidth="250.0" text="Rating Distribution" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <BarChart fx:id="barChart" prefHeight="150.0">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </BarChart>
   </children>
</VBox>
